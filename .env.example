# Application / 应用配置
APP_NAME="AI Guided SQL Assessment"
APP_ENV=development
APP_SECRET_KEY="change-me"

# Database / 数据库
# Windows local demo may use SQLite:
# Windows 单机体验模式可使用 SQLite：
# DATABASE_URL="sqlite:///./runtime/app.db"
DATABASE_URL="mysql+pymysql://user:password@127.0.0.1:3306/ai_guided_sql_assessment"

# AI Provider / AI 服务配置
# Real generation only uses the teacher's session-level API Key from the web page.
# 真实生成只读取教师在页面中临时填写的会话级 API Key，不从 .env 读取真实 Key。
AI_PROVIDER=deepseek
DEEPSEEK_BASE_URL="https://api.deepseek.com"
DEEPSEEK_ALLOWED_MODELS=deepseek-v4-flash,deepseek-v4-pro
DEEPSEEK_DEFAULT_MODEL=deepseek-v4-flash
AI_REQUEST_TIMEOUT_SECONDS=60
# Local development can keep this false; enable true behind HTTPS.
# 本地开发可为 false；公网 HTTPS 部署建议设为 true。
AI_SESSION_COOKIE_SECURE=false
# Session API Key expires after this many idle seconds.
# 当前会话 API Key 空闲超过该秒数后自动失效。
AI_SESSION_KEY_IDLE_TIMEOUT_SECONDS=14400
# Maximum in-memory session API Key entries for single-process demo.
# 单进程演示模式下最多保留的会话 Key 数量。
AI_SESSION_KEY_MAX_ENTRIES=200
# Maximum characters used from lesson materials when building AI prompt.
# 构造 AI prompt 时使用的课次材料最大字符数。
AI_PROMPT_MATERIAL_MAX_CHARS=12000

# SQL grading / SQL 批阅配置
SQL_GRADING_ENGINE="sqlite_demo"
SQL_GRADING_TIMEOUT_SECONDS=5
SQL_GRADING_MAX_ROWS=200
