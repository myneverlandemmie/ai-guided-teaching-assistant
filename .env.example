# Application / 应用配置
APP_NAME="AI Guided SQL Assessment"
APP_ENV=development
APP_SECRET_KEY="change-me"

# Database / 数据库
# Windows local demo may use SQLite:
# Windows 单机体验模式可使用 SQLite：
# DATABASE_URL="sqlite:///./runtime/app.db"
DATABASE_URL="mysql+pymysql://user:password@127.0.0.1:3306/ai_guided_sql_assessment"

# DeepSeek API / DeepSeek 接口
# Do not commit real API keys.
# 不要提交真实 API Key。
DEEPSEEK_API_KEY=""
DEEPSEEK_BASE_URL="https://api.deepseek.com"
DEEPSEEK_DEFAULT_MODEL="deepseek-v4-flash"
DEEPSEEK_STRONG_MODEL="deepseek-v4-pro"

# AI demo mode / AI 演示模式
# Set to true to use mock AI responses without API calls.
# 设为 true 时使用 Mock AI 输出，不产生 API 调用费用。
AI_MOCK_MODE=true

# SQL grading / SQL 批阅配置
SQL_GRADING_ENGINE="sqlite_demo"
SQL_GRADING_TIMEOUT_SECONDS=5
SQL_GRADING_MAX_ROWS=200
